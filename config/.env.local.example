# ============================================
# SIMDIR - Environment Configuration
# ============================================
# Copy file ini ke .env.local dan isi dengan nilai yang sesuai:
#   cp config/.env.local.example .env.local
#
# Cara mendapatkan nilai Supabase:
#   1. Buka Supabase Dashboard (https://supabase.com/dashboard)
#   2. Pilih project Anda
#   3. Masuk ke Project Settings → API
#   4. Copy URL, anon key, dan service role key
#
# Cara mendapatkan Legacy JWT Secret:
#   1. Supabase Dashboard → Project Settings → Configuration → API
#   2. Scroll ke bawah bagian "Legacy JWT secret"
#   3. Copy nilai "Legacy JWT secret"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Legacy JWT Secret (untuk verifikasi token lama)
LEGACY_JWT_SECRET=your-legacy-jwt-secret-here

# Session Secret (untuk menandatangani cookie simdir_session_local — HARUS
# berbeda dari LEGACY_JWT_SECRET, dan HARUS unik per environment/production).
# Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=your-own-random-session-secret-here
