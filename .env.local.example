# ==========================================
# SUPABASE CONFIGURATION
# ==========================================

# Supabase Project URL
# Contoh: https://abcdefgh12345678.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Public - untuk client/browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase Service Role Key (Private - server only)
# Untuk akses admin dan bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ==========================================
# LEGACY JWT SECRET (ISI DI SINI)
# ==========================================
# Copy dari: Supabase Dashboard → Project Settings → Configuration → API
# Cari bagian: "Legacy JWT secret (still used)"
# Tempelkan value-nya di bawah ini:

LEGACY_JWT_SECRET=367ZJM3XKfJa8vxHW/vzmbRXlQcRPb4NPGA6jVguF6rWMADVAkT3Tbb6DOwJkL4yXpvNhsz6Y6WJYdT6UKArWQ==

# ==========================================
# APP JWT CONFIGURATION (Custom)
# ==========================================
# Untuk aplikasi Anda sendiri (opsional)
APP_JWT_SECRET=0a9eb5e5-bb85-427d-9f90-9623c02a55fd
JWT_EXPIRES_IN=7d

